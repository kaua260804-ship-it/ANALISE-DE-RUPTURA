nbdist/
.nb-gradle/

# ============================================
# ARQUIVOS TEMPORÁRIOS E CACHE
# ============================================
# Logs
*.log
logs/
*.log.*

# Cache
.cache/
.tmp/
temp/
tmp/
*.tmp

# Arquivos temporários do Excel
~$*.xlsx
~$*.xls
~$*.xlsm

# Arquivos temporários do Office
~*.docx
~*.pptx
~*.xlsx

# ============================================
# ARQUIVOS DE CONFIGURAÇÃO LOCAL
# ============================================
# Configurações pessoais
config.local.json
config.local.js
.env
.env.local
.env.development
.env.production
.env.test

# ============================================
# BUILD E DEPLOY
# ============================================
# Builds
build/
dist/
out/
*.bundle.js
*.min.js
*.min.css

# ============================================
# BACKUP E VERSIONAMENTO
# ============================================
# Backups
*.bak
*.backup
*.old
*.orig
*.save

# ============================================
# ARQUIVOS ESPECÍFICOS DO PROJETO
# ============================================
# Se você gerar relatórios exportados
dados_analise.csv
dados_analise.xlsx
relatorios/
exports/
downloads/

# ============================================
# GIT
# ============================================
.git/
.gitignore
.gitattributes
.gitmodules

# ============================================
# DIVERSOS
# ============================================
# Arquivos compactados
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Arquivos de texto temporários
*.tmp.txt
*.temp.txt

# Screenshots e imagens temporárias
screenshots/
*.png.tmp
*.jpg.tmp

# ============================================
# PERMITIR ARQUIVOS ESPECÍFICOS
# ============================================
# Permitir README
!README.md

# Permitir arquivos HTML, CSS, JS
!*.html
!*.css
!*.js

# Permitir configurações específicas
!config.json
!js/config.js

# Permitir imagens e ícones
!*.svg
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.ico
!*.webp

# ============================================
# NOTAS
# ============================================
# Para versionar os arquivos Excel (se necessário):
# 1. Remova/Comente as linhas *.xlsx
# 2. Ou use git add -f "BASE ESTOQUE.xlsx"
#
# Para ignorar apenas arquivos específicos:
# BASE ESTOQUE.xlsx
# BASE CADASTRO.xlsx
# VENDA 26.xlsx
#
# Para verificar quais arquivos serão ignorados:
# git status --ignored
